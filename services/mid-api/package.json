{
  "name": "subete-mid-api",
  "version": "1.0.0",
  "description": "API MID del clúster Súbete: puntaje de confianza y calificaciones validadas (Grupo B)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint:openapi": "npx --yes @stoplight/spectral-cli lint --ruleset ../../spectral-ruleset.yaml --fail-severity=error docs/openapi/openapi.yaml"
  },
  "keywords": [
    "subete",
    "microservicios",
    "mid",
    "reputacion",
    "express",
    "typescript"
  ],
  "author": "Grupo B — Pasajeros y reputación",
  "license": "ISC",
  "dependencies": {
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
