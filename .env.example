
# Cabecera secreta que agrega el API Gateway a cada petición reenviada.
GATEWAY_SECRET=valor-acordado-con-el-lider-del-gateway

# Entorno de ejecución: development | test | production
NODE_ENV=development
CRUD_API_PORT=3001
DATABASE_URL=postgresql://usuario_grupo_b:contrasena_local@localhost:5432/subete_grupo_b
MID_API_PORT=3002

# Dirección única de entrada al ecosistema el API Gateway.
GATEWAY_URL=http://localhost:8080

# Credenciales Client Credentials emitidas por el líder del gateway.
GATEWAY_CLIENT_ID=mid-reputacion-grupo-b
GATEWAY_CLIENT_SECRET=valor-seguro-en-github-secrets

# Bases por defecto de los consumos: enrutan a través del gateway.
# Se dejan como variables para poder apuntarlos a un mock en pruebas locales.
RESERVAS_URL=http://localhost:8080
CRUD_URL=http://localhost:8080

# Alcances (scopes) que el gateway valida en los tokens que usamos.
SCOPE_LEER=perfiles:leer
SCOPE_ESCRIBIR=perfiles:escribir   # a confirmar con el líder del gateway
SCOPE_RESERVAS=reservas:leer

# Resiliencia HTTP (también aplica a OpenAI Moderation)
HTTP_TIMEOUT_MS=3000               # tiempo máximo de espera por petición
HTTP_REINTENTOS=2                  # reintentos limitados (solo 503 y red)
HTTP_ESPERA_BASE_MS=200            # espera base del backoff entre intentos
TOKEN_MARGEN_VENCIMIENTO_S=30      # margen para renovar el token antes de vencer

# OpenAI Moderation API (analiza el texto de los comentarios).
OPENAI_API_KEY=
OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_TIMEOUT_MS=5000
OPENAI_MODERATION_MAX_RETRIES=2
OPENAI_MODERATION_CACHE_TTL_MS=300000
# Plan de degradación si OpenAI falla o no está configurado:
#   permitir -> la calificación continúa (moderación marcada como degradada)
#   503      -> responde 503 moderacion_no_disponible
OPENAI_MODERATION_PLAN_DEGRADACION=permitir
# Umbral opcional de rechazo por puntaje (0 = desactivado; ej. 0.8)
OPENAI_MODERATION_FAIL_THRESHOLD=0.9